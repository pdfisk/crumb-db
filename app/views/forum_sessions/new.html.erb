<% content_for :title, "Sign in" %>
<section class="forum-card">
  <h1>Sign in</h1>
  <p>Use the name and password you use in the FastBlips IDE.</p>
  <%= form_with url: forum_sign_in_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :return_to, @return_to %>
    <p>
      <%= label_tag :name, "Name" %>
      <%= text_field_tag :name, @name, autocomplete: "username", required: true, autofocus: true %>
    </p>
    <p>
      <%= label_tag :password, "Password" %>
      <%= password_field_tag :password, nil, autocomplete: "current-password", required: true %>
    </p>
    <p><%= submit_tag "Sign in", class: "forum-button" %></p>
  <% end %>
  <p class="forum-muted">No account yet? <a href="https://fastblips.com">Register in the IDE</a>.</p>
</section>
